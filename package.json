{
  "name": "brawlhub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,bot -c cyan,magenta \"npm:dev:web\" \"npm:dev:bot\"",
    "dev:web": "npm run dev --workspace @brawlhub/web",
    "dev:bot": "npm run dev --workspace @brawlhub/bot",
    "build": "npm run build --workspace @brawlhub/web",
    "start": "npm run start --workspace @brawlhub/web",
    "bot:start": "npm run start --workspace @brawlhub/bot",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node scripts/migrate.mjs",
    "db:status": "node scripts/migrate.mjs --status"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.11",
    "concurrently": "^9.1.2",
    "pg": "^8.16.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
