{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@brawlhub/shared": ["./packages/shared/src/index.ts"],
      "@brawlhub/logging": ["./packages/logging/src/index.ts"],
      "@brawlhub/database": ["./packages/database/src/index.ts"],
      "@brawlhub/brawl-stars": ["./packages/brawl-stars/src/index.ts"],
      "@brawlhub/sync": ["./packages/sync/src/index.ts"]
    }
  }
}
