# Copy to .env and fill in real values. NEVER commit .env.
# Only NEXT_PUBLIC_* variables are safe to expose to the browser.

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# Supabase / Postgres
# In Supabase: enable Discord provider under Authentication > Providers and add
# http://localhost:3000/api/auth/callback to the allowed redirect URLs.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Trusted server-side only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection string, used by `npm run db:migrate`.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Official Brawl Stars API (https://developer.brawlstars.com/)
# Developer API key sent as `Authorization: Bearer <key>` (no token endpoint, no caching).
BRAWL_STARS_API_KEY=your-api-key
BRAWL_STARS_BASE_URL=https://api.brawlstars.com/v1
SYNC_INTERVAL_MINUTES=15
# Optional server-side secret required by the /api/sync cron endpoint.
# Send it as `Authorization: Bearer <SYNC_SECRET>`; when blank the endpoint returns 503.
SYNC_SECRET=
# Minimum delay between Brawl Stars API requests in milliseconds (default 250).
BRAWL_STARS_MIN_INTERVAL_MS=250

# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
DISCORD_CLIENT_SECRET=your-client-secret
DISCORD_GUILD_ID=your-guild-id
DISCORD_CALLBACK_URL=http://localhost:3000/api/auth/callback
# Optional Discord channel ID for membership-change notifications (blank disables notifications).
DISCORD_NOTIFICATION_CHANNEL_ID=
# Website role mapping. The guild owner is always a BrawlHub owner.
# Comma-separated Discord role IDs that grant global Owner/Administrator.
DISCORD_OWNER_ROLE_IDS=
DISCORD_ADMIN_ROLE_IDS=
# JSON mapping of club tags to club-specific Discord roles. Tags may include '#'.
# Example: {"2UG9UGQJY":{"presidentRoleIds":["123..."],"staffRoleIds":["456..."]}}
DISCORD_ROLE_MAP={}
# Optional custom emoji IDs for bot embeds (Discord snowflakes).
DISCORD_EMOJI_TROPHIES=
DISCORD_EMOJI_TROPHY_RANGE=
DISCORD_EMOJI_PRESIDENT=
DISCORD_EMOJI_REQUIRED_TROPHIES=
DISCORD_EMOJI_MEMBERS=
DISCORD_EMOJI_MATCHES=
DISCORD_EMOJI_PROGRESSION=
DISCORD_EMOJI_DESCRIPTION=
# Player profile link template. Must contain {tag}; blank disables clickable links.
BRAWL_STARS_PROFILE_URL_TEMPLATE=https://brawlify.com/player/{tag}
