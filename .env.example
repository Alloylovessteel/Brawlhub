# Copy to .env and fill in real values. NEVER commit .env.
# Only NEXT_PUBLIC_* variables are safe to expose to the browser.

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# Supabase / Postgres
# In Supabase: enable Discord provider under Authentication > Providers and add
# http://localhost:3000/api/auth/callback to the allowed redirect URLs.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Trusted server-side only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection string, used by `npm run db:migrate`.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Official Brawl Stars API (https://developer.brawlstars.com/)
# Developer API key sent as `Authorization: Bearer <key>` (no token endpoint, no caching).
BRAWL_STARS_API_KEY=your-api-key
BRAWL_STARS_BASE_URL=https://api.brawlstars.com/v1
SYNC_INTERVAL_MINUTES=15

# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
DISCORD_CLIENT_SECRET=your-client-secret
DISCORD_GUILD_ID=your-guild-id
DISCORD_CALLBACK_URL=http://localhost:3000/api/auth/callback
