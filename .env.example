# Copy to .env and fill in real values. NEVER commit .env.
# Only NEXT_PUBLIC_* variables are safe to expose to the browser.

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# Supabase / Postgres
# In Supabase: enable Discord provider under Authentication > Providers and add
# http://localhost:3000/api/auth/callback to the allowed redirect URLs.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Trusted server-side only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection string, used by `npm run db:migrate`.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Official Brawl Stars API (https://developer.brawlstars.com/)
# Developer API key sent as `Authorization: Bearer <key>` (no token endpoint, no caching).
BRAWL_STARS_API_KEY=your-api-key
BRAWL_STARS_BASE_URL=https://api.brawlstars.com/v1
SYNC_INTERVAL_MINUTES=15
# Club stats overview refresh cadence in minutes (default 30, clamped to 1-1440).
# The channel itself is configured per server with `/settings set-overview-channel`.
OVERVIEW_INTERVAL_MINUTES=30
# Optional server-side secret required by the /api/sync cron endpoint.
# Send it as `Authorization: Bearer <SYNC_SECRET>`; when blank the endpoint returns 503.
SYNC_SECRET=
# Minimum delay between Brawl Stars API requests in milliseconds (default 150).
BRAWL_STARS_MIN_INTERVAL_MS=150

# BrawlAPI by Brawlify (https://brawlapi.com/) — optional static metadata only.
# The official Brawl Stars API remains the source of truth for players, clubs,
# stats, brawler names and live event rotation. BrawlAPI is only used for asset
# URLs and metadata the official API does not expose (icons, badges, maps, modes).
BRAWLAPI_BASE_URL=https://api.brawlapi.com
BRAWLAPI_TIMEOUT_MS=5000
BRAWLAPI_CACHE_TTL_MS=3600000

# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
DISCORD_CLIENT_SECRET=your-client-secret
# Optional fast-update guild. Commands are also registered globally and to every joined guild.
DISCORD_GUILD_ID=your-guild-id
DISCORD_CALLBACK_URL=http://localhost:3000/api/auth/callback
# Optional Discord channel ID for membership-change notifications (blank disables notifications).
DISCORD_NOTIFICATION_CHANNEL_ID=
# Scheduled full-page club-log PNG posts (1-1440 minutes). Periods are chosen per
# subscription with `/clubs clublogs add ... period:...`; the old global variable is unused.
CLUB_LOGS_INTERVAL_MINUTES=5
# Keep reports as scheduled auto-posts only. Set to 1 only for explicit startup testing.
REPORTS_IMMEDIATE_ON_START=false
# Website role mapping. The guild owner is always a BrawlHub owner.
# Comma-separated Discord role IDs that grant global Owner/Administrator.
DISCORD_OWNER_ROLE_IDS=
DISCORD_ADMIN_ROLE_IDS=
# JSON mapping of club tags to club-specific Discord roles. Tags may include '#'.
# Example: {"CLUBTAG":{"presidentRoleIds":["123..."],"staffRoleIds":["456..."]}}
DISCORD_ROLE_MAP={}
# Optional custom emoji IDs for bot embeds (Discord snowflakes).
DISCORD_EMOJI_TROPHIES=
DISCORD_EMOJI_TROPHY_RANGE=
DISCORD_EMOJI_PRESIDENT=
DISCORD_EMOJI_REQUIRED_TROPHIES=
DISCORD_EMOJI_MEMBERS=
DISCORD_EMOJI_MATCHES=
DISCORD_EMOJI_PROGRESSION=
DISCORD_EMOJI_DESCRIPTION=
# Optional club-overview emojis. Unicode fallbacks are used when these are blank.
DISCORD_EMOJI_RANKED=
DISCORD_EMOJI_RANK=
# Tier-specific rank icons shown before each rank name (e.g. "Mythic II").
# Unset tiers fall back to DISCORD_EMOJI_RANK / 🔹.
DISCORD_EMOJI_RANK_MYTHIC=
DISCORD_EMOJI_RANK_LEGENDARY=
DISCORD_EMOJI_RANK_MASTERS=
DISCORD_EMOJI_RANK_PRO=
DISCORD_EMOJI_MEGAPIG=
DISCORD_EMOJI_WINS=
DISCORD_EMOJI_ONLINE=
# Player profile link template. Must contain {tag}; blank disables clickable links.
BRAWL_STARS_PROFILE_URL_TEMPLATE=https://brawlify.com/player/{tag}
# Optional registered-club link template. Must contain {tag}; blank keeps club names plain.
BRAWL_STARS_CLUB_URL_TEMPLATE=
# Optional UTC timestamp for the current Brawl Stars season start.
# Season trophy progression and season match counts are omitted until this is explicitly configured.
# Example: 2026-11-05T08:00:00Z (Season 56 "Brawl Vice")
BRAWL_SEASON_START_ISO=
# Optional UTC window for Mega Pig estimates (official Mega Pig stats are not exposed by the Brawl Stars API).
# When both are set, BrawlHub estimates Mega Pig activity from collected battle logs in this window.
# Example: 2026-12-05T08:00:00Z / 2026-12-08T08:00:00Z
BRAWL_MEGA_PIG_START_ISO=
BRAWL_MEGA_PIG_END_ISO=
# Collect player battle logs during sync to compute match/activity stats (default true).
SYNC_COLLECT_BATTLE_LOGS=true
# Fetch full player profiles during sync to store extra stats like fame/ranked/victories (default true).
SYNC_COLLECT_PLAYER_PROFILES=true
